  },
  "icon": "assets/icon.png",
  "license": "Vim",
  "repository": {
    "type": "git",
    "url": "https://github.com/r11s/morning-vscode-theme"
  },
  "bugs": {
    "url": "https://github.com/r11s/morning-vscode-theme/issues"
